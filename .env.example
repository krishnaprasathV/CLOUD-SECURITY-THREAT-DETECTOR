# ==============================================================================
# Cloud Security Threat Detector - Environment Configuration
# Wipro COE – WE CPPE One-Day Capstone Project
# ==============================================================================

# Application Settings
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=wipro-cppe-cloud-sec-detector-supersecretkey-2026
PORT=5000
HOST=127.0.0.1

# Persistence
DATABASE_PATH=threat_detector.db
UPLOAD_FOLDER=data/uploads
MAX_CONTENT_LENGTH_MB=16

# Security Detection Engine Thresholds (Configurable)
DETECTION_FAILED_ATTEMPT_THRESHOLD=4
DETECTION_TIME_WINDOW_MINUTES=15
DETECTION_SPRAY_USER_COUNT=3
DETECTION_VELOCITY_THRESHOLD=10
DETECTION_VELOCITY_WINDOW_MINUTES=5

# Generative AI & Explainability
ENABLE_LOCAL_EXPLAINER=true
LLM_PROVIDER=local_rule_based
# Optional External LLM Key (Leave blank to use zero-cost offline local explainability)
OPENAI_API_KEY=

# AWS Learner Lab Settings (Optional)
# Leave AWS_OFFLINE_MODE=true for local development with simulated AWS metrics
AWS_OFFLINE_MODE=true
AWS_REGION=us-east-1
AWS_S3_BUCKET=wipro-security-threat-logs-demo
AWS_CLOUDWATCH_NAMESPACE=Wipro/CloudSecurityThreatDetector
